PORT=4000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

JWT_ACCESS_SECRET=your-secure-access-secret
JWT_ACCESS_TTL=15m

JWT_REFRESH_SECRET=your-secure-refresh-secret
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8090,http://localhost:19006,https://*.vercel.app

# Google Gemini AI API Key for AI Assistant & Receipt Bill Scanner
GEMINI_API_KEY=

# Gmail account used to send "forgot password" OTP emails via nodemailer.
# EMAIL_PASSCODE must be a Gmail App Password (myaccount.google.com/apppasswords), not your
# normal login password — Gmail rejects SMTP auth with the account password directly.
EMAIL_USER=
EMAIL_PASSCODE=

# Deals engine mode: "provider" (default) tries only real-marketplace providers (Flipkart, once
# configured below) and returns an empty/unavailable result if none are configured yet — no
# AI-generated deals. "legacy" restores the old Gemini-generated deal finder for comparison.
# Can also be overridden per-request via GET /deals/search?engine=legacy.
DEALS_ENGINE_MODE=provider

# Flipkart Affiliate API credentials (optional — leave blank until you have a real, approved
# Flipkart affiliate account; the provider stays "unavailable" and makes no network calls until
# both are set AND the real API integration is implemented in
# src/modules/deals/providers/flipkart.provider.ts).
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
